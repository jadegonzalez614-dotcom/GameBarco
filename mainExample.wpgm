import wollok.game.*

import barco.*
import historia.*
import personaje.*
import jugar.*
import barco2.*




program jugar {
  game.width(15)
  game.height(10)
  game.cellSize(64)

  //game.boardGround("oceanopixel.jpg")

  //game.addVisualCharacter(barco)
  barco2.iniciar()



  keyboard.w().onPressDo({ barco2.subir() })
  keyboard.s().onPressDo({ barco2.bajar() })
  keyboard.a().onPressDo({ barco2.izquierda() })
  keyboard.d().onPressDo({ barco2.derecha() })


  game.title("Juego del Barco Mortal")

  game.start()
}



