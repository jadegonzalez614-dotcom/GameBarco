program juego {
  game.title("Teseo y el Minotauro")
  game.width(15)
  game.height(10)
  game.cellSize(64)

  game.boardGround("fondogriegosintexto.jpg")

  game.addVisual(historia)

  // La tecla ENTER para avanzar en la historia
  keyboard.enter().onPressDo({historia.avanzarConLaHistoria() })

  game.start()
}